# Next.js / Turbopack build output (ignore everywhere)
.next/
.turbo/

# Safety: if a build output was ever generated under src/
src/.next/
src/.turbo/
node_modules/
.swc/
.vercel/

# Local env (never commit)
.env
.env.local
.env.production

# Dependencies (never commit)
.env.*
*.env
*.env.*
.DS_Store
.npmrc
*.tsbuildinfo

# local backups
src/lib/*.bak.*

# accidental terminal artifacts
NODE_ENV=production
nextn@0.1.0
tsc

# DF / experiments
eslint.config.js.GEMINI_BACKUP.*
scripts/tmp/

# Local DF memory (never commit)
DF_BRAIN/

# local fixture backups
tests/__fixtures__/*.bak.*

# flake-hunt artifacts
/test-run-*.log

# integration Next distDir
.next-int/
