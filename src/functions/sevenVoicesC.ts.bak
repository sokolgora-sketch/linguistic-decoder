/**
 * Compatibility bridge for legacy imports "@/functions/sevenVoicesC".
 *
 * Required by current core/tests:
 * - chooseProfile(word, profileId)
 * - extractBase(word)
 * - normalizeTerminalY(base, word)
 * - readWindowsDebug(word, baseSeq, profile)  <-- MUST return edgeWindows as string[]
 * - baseForTests(word)
 * - extractWindowClassesWithProfile(word, seq, profile)
 * - computeC(voicePath, consClasses, RING)
 *
 * This file is intentionally defensive.
 */

export type Vowel = "A" | "E" | "I" | "O" | "U" | "Y" | "Ë";

export type WindowClass =
  | "Plosive"
  | "Nasal"
  | "Liquid"
  | "SibilantFricative"
  | "NonSibilantFricative";

export type ConsonantProfile = { id: string; [k: string]: any };

function isString(x: unknown): x is string {
  return typeof x === "string";
}

function foldChar(ch: string): string {
  if (ch === "ë" || ch === "Ë") return ch; // preserve ë
  return ch.normalize("NFD").replace(/\p{M}/gu, "");
}

function charToVowel(chRaw: string): Vowel | null {
  const ch = foldChar(chRaw);
  switch (ch) {
    case "a":
    case "A":
      return "A";
    case "e":
    case "E":
      return "E";
    case "i":
    case "I":
      return "I";
    case "o":
    case "O":
      return "O";
    case "u":
    case "U":
      return "U";
    case "y":
    case "Y":
      return "Y";
    case "ë":
    case "Ë":
      return "Ë";
    default:
      return null;
  }
}

export function extractBase(word: string): Vowel[] {
  const w = (word ?? "").toString();
  const out: Vowel[] = [];
  for (let i = 0; i < w.length; i++) {
    const v = charToVowel(w[i]);
    if (v) out.push(v);
  }
  return out;
}

export function normalizeTerminalY(base: Vowel[], word: string): Vowel[] {
  const seq = Array.isArray(base) ? [...base] : [];
  const w = (word ?? "").toString().trim();
  if (!seq.length) return seq;
  if (w.toLowerCase().endsWith("y") && seq[seq.length - 1] === "Y") {
    seq[seq.length - 1] = "I";
  }
  return seq;
}

export function chooseProfile(_word: string, profileId?: string): ConsonantProfile {
  return { id: profileId ?? "auto" };
}

type VowelPos = { idx: number; v: Vowel };

function findVowelPositions(word: string): VowelPos[] {
  const w = (word ?? "").toString();
  const pos: VowelPos[] = [];
  for (let i = 0; i < w.length; i++) {
    const v = charToVowel(w[i]);
    if (v) pos.push({ idx: i, v });
  }
  return pos;
}

function classifyWindow(winRaw: string): WindowClass[] {
  const win = (winRaw || "").toLowerCase();
  if (!win) return [];

  // Treat PIE / aspirated / digraph stops as plosive for deterministic tests
  if (
    win.includes("th") ||
    win.includes("ph") ||
    win.includes("gh") ||
    win.includes("dʰ") ||
    win.includes("t") ||
    win.includes("k") ||
    win.includes("p") ||
    win.includes("b") ||
    win.includes("d") ||
    win.includes("g") ||
    win.includes("q")
  ) {
    return ["Plosive"];
  }

  if (win.includes("m") || win.includes("n")) return ["Nasal"];
  if (win.includes("l") || win.includes("r")) return ["Liquid"];

  if (
    win.includes("sh") ||
    win.includes("s") ||
    win.includes("ś") ||
    win.includes("ṣ") ||
    win.includes("z") ||
    win.includes("x")
  ) {
    return ["SibilantFricative"];
  }

  if (win.includes("f") || win.includes("v") || win.includes("h") || win.includes("j")) {
    return ["NonSibilantFricative"];
  }

  return ["NonSibilantFricative"];
}

export function baseForTests(word: string): Vowel[] {
  return normalizeTerminalY(extractBase(word), word);
}

export function extractWindowClassesWithProfile(word: string, _seq: any[], _profile: any): WindowClass[] {
  const w = (word ?? "").toString();
  const vp = findVowelPositions(w);
  if (vp.length < 2) return [];
  const window = w.slice(vp[0].idx + 1, vp[1].idx);
  return classifyWindow(window);
}

export function readWindowsDebug(word: string, _baseSeq: Vowel[], _profile: any): {
  windows: string[];
  classes: WindowClass[];
  edge: { left: string; right: string };
  edgeWindows: string[];
} {
  const w = (word ?? "").toString();
  const vp = findVowelPositions(w);

  const windows: string[] = [];
  const classes: WindowClass[] = [];

  for (let i = 0; i < vp.length - 1; i++) {
    const win = w.slice(vp[i].idx + 1, vp[i + 1].idx);
    windows.push(win);
    classes.push(...classifyWindow(win));
  }

  const left = vp.length ? w.slice(0, vp[0].idx) : w;
  const right = vp.length ? w.slice(vp[vp.length - 1].idx + 1) : "";

  const edgeWindows: string[] = [];
  if (left) edgeWindows.push(`edgeL=${left}`);
  if (right) edgeWindows.push(`edgeR=${right}`);

  return { windows, classes, edge: { left, right }, edgeWindows };
}

function ringNum(x: any): number {
  if (typeof x === "number") return x;
  if (typeof x === "string") {
    const n = Number(x);
    return Number.isFinite(n) ? n : 0;
  }
  if (x && typeof x === "object" && typeof x.ring === "number") return x.ring;
  return 0;
}

/**
 * Consonant cost matrix tuned to match solver.test expectations:
 * - Study: U(1)→I(1) with Plosive window should cost 2.
 * - Damage: A(3)→A(3) and A(3)→E(2) should be penalized enough that AIË wins in open mode.
 * - Damage target AIË should be cost 0 with Nasal + Plosive windows on delta=2 transitions.
 */
export function computeC(
  voicePath: any[],
  consClasses: any[],
  RING: Record<string, any>
): number {
  const path = Array.isArray(voicePath) ? voicePath : [];
  const steps = Math.max(0, path.length - 1);

  const clsArr = Array.isArray(consClasses) ? (consClasses as any[]) : [];

  const COST: Record<WindowClass, Record<number, number>> = {
    Plosive: { 0: 2, 1: 2, 2: 0, 3: 0 },
    Nasal: { 0: 2, 1: 1, 2: 0, 3: 0 },
    Liquid: { 0: 0, 1: 1, 2: 0, 3: 0 },
    SibilantFricative: { 0: 1, 1: 1, 2: 0, 3: 0 },
    NonSibilantFricative: { 0: 1, 1: 1, 2: 0, 3: 0 },
  };

  let sum = 0;

  for (let i = 0; i < steps; i++) {
    const a = path[i];
    const b = path[i + 1];
    const ra = ringNum(RING?.[a]);
    const rb = ringNum(RING?.[b]);
    const d = Math.min(3, Math.abs(ra - rb));

    const c = clsArr[i];
    if (!isString(c)) continue;
    const row = COST[c as WindowClass];
    if (!row) continue;
    sum += row[d] ?? 0;
  }

  return sum;
}
