{
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "data/**/*.ts",
    "data/**/*.tsx",
    "*.ts",
    "*.tsx"
  ],
  "exclude": ["node_modules", ".next", "out", "dist", "coverage"]
}
